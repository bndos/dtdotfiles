/* Global settings and color variables */
configuration {
    columns: 2;
    font: "MonacoB2 13";
    bw: 0;
    location: 0;
    padding: 0;
    click-to-exit: true;
    display-window: "";
    display-windowcd: "";
    display-drun: ">";
    display-combi: "";
    kb-remove-word-back: "Control+BackSpace,Alt+d,Alt+BackSpace";
    kb-accept-entry: "Control+m,Return,KP_Enter,Alt+m";
    kb-mode-next: "Shift+Right,Control+Tab,Alt+l,Alt+Tab";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab,Alt+h";
    kb-row-left: "Control+Page_Up,Control+Alt+h";
    kb-row-right: "Control+Page_Down,Control+Alt+l";
    kb-row-up: "Up,Control+p,ISO_Left_Tab,Alt+k";
    kb-row-down: "Down,Control+n,Alt+j";
    kb-select-1: "";
    kb-select-2: "";
    kb-select-3: "";
    kb-select-4: "";
    kb-select-5: "";
    kb-select-6: "";
    kb-select-7: "";
    kb-select-8: "";
    kb-select-9: "";
    kb-select-10: "";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    me-accept-custom: "MouseMiddle";
}

* {
   maincolour:   #2f2f2f;
   highlight:    #ffffff;
   urgentcolour: #C40000;
   fgwhite:      #777777;
   white:        #ffffff;
   bgcolour:     #080808;
   lightblue:    #777777;
   lightgreen:   #394F61;
   font: "MonacoB2 12";
   background-color: @bgcolour;
}


window {
   background-color: @bgcolour;
   anchor: north;
   location: north;
   y-offset: 20%;
}

mainbox {
   background-color: @bgcolour;
   spacing: 0px;
   children: [inputbar, message, sidebar, listview];
}

message {
   padding: 6px 10px;
   background-color:@bgcolour;
}

textbox {
   text-color:@lightblue;
   background-color:@bgcolour;
}

listview {
   fixed-height: true;
   dynamic: true;
   scrollbar: false;
   spacing: 0px;
   padding: 8px 8px 8px 8px;
   margin: 0px 0px 1px 0px;
   background: @bgcolour;
}

element {
   padding: 2px 15px;
}

element normal.normal {
   padding: 0px 15px;
   background-color: @blueentry;
   text-color: @fgwhite;
}

element normal.urgent {
   background-color: @blueentry;
   text-color: @urgentcolour;
}

element normal.active {
   background-color: @blueentry;
   text-color: @fgwhite;
}

element selected.normal {
    background-color: @maincolour;
    text-color: @white;
}

element selected.urgent {
    background-color: @urgentcolour;
    text-color: @bgcolour;
}

element selected.active {
    background-color: @maincolour;
    text-color: @lightgreen;
}

element alternate.normal {
    background-color: @blueentry;
    text-color: @fgwhite;
}

element alternate.urgent {
    background-color: @blueentry;
    text-color: @urgentcolour;
}

element alternate.active {
    background-color: @lightgreen;
    text-color: @white;
}

scrollbar {
   background-color: @bgcolour;
   handle-color: @lightgreen;
   handle-width: 15px;
}

sidebar {
   background-color: @bgcolour;
}

button {
   background-color: @bgcolour;
   text-color: @lightblue;
}

button selected {
    text-color: @white;
}

inputbar {
   background-color: @bgcolour;
   spacing: 0px;
}

prompt {
   padding: 6px 9px;
   background-color: @bgcolor;
   text-color: @white;
}

entry {
   padding: 6px 10px;
   background-color: @bgcolour;
   text-color: @fgwhite;
}

case-indicator {
   padding: 6px 10px;
   text-color: @maincolour;
   background-color: @bgcolour;
}
