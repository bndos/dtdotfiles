set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 8
map [normal]     h   navigate previous
map [fullscreen] h   navigate previous
map [normal]     l navigate next
map [fullscreen] l navigate next
map i recolor

#font
set font "Monaco Bold 12"
set window-title-basename true

#colors
set default-bg 	 "#00000000"
set statusbar-bg "#000000"

set default-fg   "#FFFFFF"
set statusbar-fg "#FFFFFF"
