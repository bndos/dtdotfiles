# default setup
set window-title-basename true
set window-title-page true
set statusbar-basename true
set statusbar-h-padding 32
set statusbar-v-padding 16
set page-padding 3
set selection-clipboard "clipboard"

# mapping
map u scroll half-up
map d scroll half-down
map H scroll half-left
map L scroll half-right
map [normal]     h   navigate previous
map [fullscreen] h   navigate previous
map [normal]     l navigate next
map [fullscreen] l navigate next
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map P print

set font "Consolas 10"
# highlighting
set highlight-color orange
set highlight-active-color red

# recolor options
set recolor-darkcolor "#eeeeee"
set recolor-lightcolor "#151515"
set recolor-keephue true

# menu colors (: TAB)
set completion-bg "#000000"
set completion-fg "#eeeeee"
set completion-highlight-bg "#D64C4B"
set completion-highlight-fg black

# group titles in menu (:open TAB)
set completion-group-fg "#eeeeee"
set completion-group-bg "#000000"

# index menu colors
set index-bg                    "#000000" # Background
set index-fg                    "#eeeeee" # Foreground
set index-active-bg             "#D64C4B" # Current Line
set index-active-fg             "#000000" # Foreground

# :bdelete ENTER (no bookmarks, shows errors)
set notification-error-bg       "#D64C4B" # red
set notification-error-fg       "#eeeeee"

set notification-warning-bg     "#ffb86c" # Orange
set notification-warning-fg     "#44475a" # Selection

# :blist ENTER (when no bookmarks, shows a notification)
set notification-bg             "#D68844" # orange
set notification-fg             "#000000"

# typing bar bottom
set inputbar-bg "#000000" # Background
set inputbar-fg "#eeeeee" # Background
# regular bar bottom
set statusbar-bg "#000000" # Background
set statusbar-fg "#ffffff" # Foreground

set n-completion-items 10 # number of items displayed in menu


