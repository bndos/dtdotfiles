[colors]
background = #bb000000
background-alt = #222222
foreground = #d8dee8
foreground-alt = #585c46
accent = #bd93f9
alert = #ebcb8b
orange = #5F2513
black = #000000
cyan = #1C2323

[bar/center]
monitor = DisplayPort-0
monitor-fallback = eDP-1
; bottom = true
width = 16%
offset-x = 42%
height = 75
fixed-center = true
background = ${colors.background}
foreground = ${colors.foreground}
padding-left = 3
padding-right = 3
module-margin-left = 1
module-margin-right = 1
font-0 = Monego:style=Bold:pixelsize=10
font-1 = FontAwesome:pixelsize=8
enable-ipc = true
;tray-position = right
;tray-padding = 2
;tray-background = ${colors.background}
; radius = 2
; override-redirect = true
wm-restack = bspwm
modules-left =
modules-center = bspwm
modules-right =
dpi = 143

[bar/right]
monitor = DisplayPort-0
; bottom = true
width = 4%
offset-x = 95%
height = 55
fixed-center = true
background = ${colors.background}
foreground = ${colors.foreground}
padding-left = 3
padding-right = 3
module-margin-left = 3
module-margin-right = 3
font-0 = Monego:style=Bold:pixelsize=10
font-1 = FontAwesome:pixelsize=8
enable-ipc = true
; tray-position = right
; tray-detached = true
; tray-padding = 2
;tray-background = ${colors.background}
; radius = 2
; override-redirect = true
wm-restack = bspwm
modules-left =
modules-center = date
modules-right =
dpi = 153

[bar/full-i3]
monitor = ${env:MONITOR:DisplayPort-0}
width = 100%
height = 50
; offset-x = 0
; offset-y = 0%
radius = 0.0
fixed-center = true
enable-ipc=true
background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3
line-color = #f00

;margin of bar
border-right-size = 0
border-left-size = 0
border-color = #00000000

padding-left = 2
padding-right = 2

module-margin-left = 1
module-margin-right = 1

font-0 = Monego:style=Bold:pixelsize=10
font-1 = FontAwesome:pixelsize=8

modules-left = i3
modules-center =
modules-right = date

; tray-position = right
; tray-padding = 2
;wm-restack = bspwm
; wm-restack = i3

; override-redirect = false

;scroll-up = bspwm-desknext
;scroll-down = bspwm-deskprev

;scroll-up = i3wm-wsnext
;scroll-down = i3wm-wsprev

cursor-click = pointer
cursor-scroll = ns-resize

bottom=false
dpi = 143

[module/arrow]
type = custom/script
cursor = pointer
exec = echo "     "
click-left = bash $HOME/.config/polybar/tinybar.sh
click-right = bash $HOME/.config/polybar/killbar.sh

[module/sep]
type = custom/script
cursor = pointer
exec = echo ""
click-left = bash $HOME/.config/polybar/tinybar.sh
click-right = bash $HOME/.config/polybar/killbar.sh

[bar/full]
monitor = ${env:MONITOR:}
monitor-fallback = eDP-1
; bottom = true
width = 50%
offset-x = 25%
offset-y = -25
height = 75
fixed-center = true
background = ${colors.background}
foreground = ${colors.foreground}
padding-left = 8
padding-right = 11
module-margin-left = 1
module-margin-right = 1
font-0 = "Ubuntu:style=Bold:pixelsize=12;15"
font-1 = "FontAwesome:style=Bold:pixelsize=12;15"
enable-ipc = true
; tray-position = center
; tray-detached = true
;tray-padding = 2
;tray-background = ${colors.background}
; radius = 11
; override-redirect = false
wm-restack = bspwm
modules-left = bspwm
modules-center =
modules-right = date arrow
dpi = 143

[bar/tray]
monitor-strict = false
width = 20
height = 50
offset-x = 74% ######### offset values only dtermine the position of bar in the screen set it accordingly to your need
offset-y = 65
override-redirect = false  ############### to make offset vales to work override-direct value must be true
fixed-center = true
background = ${colors.background}
;foreground = ${colors.foreground}
radius = 10
line-size = 0
line-color = #f00
padding-left = 0
padding-right = 1
module-margin-left = 0
module-margin-right = 0
modules-right =  sep
tray-position = right
tray-detached = false
tray-offset-x = 0
tray-offset-y = 0
tray-padding = 1
tray-maxsize = 20
tray-scale = 1.0
tray-background = ${colors.background}
dpi = 143

[module/i3]
type = internal/i3
format = <label-state> <label-mode>
index-sort = true
wrapping-scroll = false
;#
;#
;#
;#
;#
;#
;
;
;
;
;
;
;
;
;
ws-icon-0 = 0;1
ws-icon-1 = 1;1
ws-icon-2 = 2;2
ws-icon-3 = 3;3
ws-icon-4 = 4;4
ws-icon-5 = 5;5
ws-icon-6 = 6;6
ws-icon-7 = 7;7
ws-icon-8 = 8;8
ws-icon-9 = 9;9
ws-icon-10 = 10;0

ws-icon-11 = 1:M1;1
ws-icon-12 = 2:M2;2
ws-icon-13 = 3:M3;3
ws-icon-14 = 4:M4;4
ws-icon-15 = 5:M5;5
ws-icon-16 = 6:M6;6
ws-icon-17 = 7:M7;7
ws-icon-18 = 8:M8;8
ws-icon-19 = 9:M9;9
ws-icon-20 = 10:M0;0

ws-icon-default = 

; Only show workspaces on the same output as the bar
pin-workspaces = true

label-mode-padding = 0
label-mode-foreground = #000
label-mode-background = ${colors.background}

; focused = Active workspace on focused monitor
label-active = %icon%
label-focused = %icon%
label-focused-background = ${module/bspwm.label-focused-background}
label-focused-foreground = ${colors.foreground}
; label-focused-underline = ${module/bspwm.label-focused-underline}
label-focused-padding = ${module/bspwm.label-focused-padding}

; unfocused = Inactive workspace on any monitor
label-unfocused = %icon%
label-unfocused-padding = ${module/bspwm.label-occupied-padding}
label-unfocused-foreground = ${colors.foreground-alt}

; visible = Active workspace on unfocused monitor
label-visible = %icon%
label-visible-background = ${self.label-focused-background}
; label-visible-underline = ${self.label-focused-underline}
label-visible-padding = ${self.label-focused-padding}

; urgent = Workspace with urgency hint set
label-urgent = %icon%
label-urgent-background = ${module/bspwm.label-urgent-background}
label-urgent-padding = ${module/bspwm.label-urgent-padding}

; Separator in between workspaces
; label-separator = |

[module/bspwm]

type = internal/bspwm
label-focused = 
label-focused-background= ${colors.background}
label-focused-foreground= ${colors.foreground}
label-focused-padding = 2
label-occupied = 
label-occupied-padding = 2
label-occupied-foreground= ${colors.foreground}
label-urgent = %name%
label-urgent-background = ${colors.alert}
label-urgent-padding = 2
label-empty = %name%
label-empty-foreground = ${colors.foreground}
label-empty-padding = 2


[module/xwindow]

type = internal/xwindow
label = %title:0:45:.%


[module/mpd]

type = internal/mpd
;format-online = <icon-prev>  <label-time>  <label-song>  <icon-next>
format-online = <toggle>  <label-song>
;format-online = <label-time>  <label-song>
;icon-prev = 
;icon-next = 
icon-play = 
icon-pause = 
;icon-prev-foreground = ${colors.accent}
;icon-next-foreground = ${colors.accent}
icon-pause-foreground = ${colors.accent}
label-song-maxlen = 45
label-song-ellipsis = true


[module/wlan]

type = internal/network
interface = wlp3s0
interval = 15
format-connected = <ramp-signal>
label-connected = %essid%
format-disconnected = <label-disconnected>
label-disconnected = 
label-disconnected-foreground = ${colors.foreground-alt}
ramp-signal-0 = 
ramp-signal-1 = 
ramp-signal-2 = 
ramp-signal-3 = 
ramp-signal-4 = 
ramp-signal-5 = 
ramp-signal-foreground = ${colors.accent}


[module/alsa]

type = internal/alsa
format-volume = <label-volume> <bar-volume>
label-volume = ""
label-volume-foreground = ${colors.accent}
format-muted-prefix = ""
format-muted-foreground = ${colors.accent}
label-muted = Muted
label-muted-foreground= ${colors.foreground-alt}
bar-volume-width = 6
bar-volume-indicator = 
bar-volume-fill = ─
bar-volume-empty = ─
bar-volume-empty-foreground = ${colors.foreground-alt}

[module/pulseaudio]

type = internal/pulseaudio
sink = alsa_output.pci-0000_12_00.3.analog-stereo
use-ui-max = true
interval = 5
format-volume = <ramp-volume>
label-muted = ""
label-muted-foreground = #888
ramp-volume-0 = 
ramp-volume-0-foreground = ${colors.foreground}
ramp-volume-1 = 
ramp-volume-1-foreground = ${colors.foreground}
ramp-volume-2 = 
ramp-volume-2-foreground = ${colors.foreground}
ramp-volume-3 = 
ramp-volume-3-foreground = ${colors.foreground}

[module/battery]

type = internal/battery
full-at = 98
battery = BAT0
adapter = ACAD
poll-interval = 60
format-charging = <ramp-capacity> <label-charging>
label-charging =  %percentage%%
label-full = Full
format-discharging = <ramp-capacity> <label-discharging>
label-discharging = %percentage%%
ramp-capacity-0 = 
ramp-capacity-1 = 
ramp-capacity-2 = 
ramp-capacity-3 = 
ramp-capacity-4 = 
ramp-capacity-foreground = ${colors.accent}


[module/date]
type = internal/date
interval = 30
label = "%date% %time%"
date =
date-alt = %a %d
time = %H:%M
time-alt =
format-prefix =
format-prefix-foreground = ${colors.accent}
