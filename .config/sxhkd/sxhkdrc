#
# wm independent hotkeys
#

# terminal emulator
super + shift + Return
	st

# program launcher
super + p
	~/.config/rofi/launchers/type-7/launcher.sh

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

#
# bspwm hotkeys
#

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close and kill
super + shift {_, hyper + } c
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# send the newest marked node to the newest preselected node
super + y
	bspc node -n 'last.!automatic.local'

# swap the current node and the biggest node
alt + Tab
        bspc node -f last.local

alt + shift + Tab
	bspc node -s smallest.local

#
# state/flags
#

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}
# Add focused window to a tabbed instance in given direction
#
hyper + t; {h,j,k,l}
    tabc1 $(bspc query -N -n {west,south,north,east}) add $(bspc query -N -n focused)

# Remove one tab from tabbed
hyper + t; r
    tabbed=$(bspc query -N -n focused); \
    child=$(tabc.sh $tabbed list | head -n1); \
    tabc1 $tabbed remove $child
#
# focus/swap
#

super + {_,shift + }{h,j,k,l}
  bspc config pointer_follows_focus true; \
  LAYOUT=$(bspc query -T -d | jq -r .layout); \
  [[ "$LAYOUT" == "tiled" ]] && bspc node -{f,s} {west,south,north,east}.local; \
  [[ "$LAYOUT" == "monocle" ]] && bspc node -{f,s} {prev,next,prev,next}.local.leaf; \
  bspc config pointer_follows_focus false;

# focus the node in the given direction
super + {minus,equal}
	bluefilter {down,up}

# focus the node for the given path jump
# super + {p,b,comma,period}
	# bspc node -f @{parent,brother,first,second}
# super + {p,b}
	# bspc node -f @{parent,brother}

super + {period, comma}
    bspc config pointer_follows_focus true; \
    bspc monitor -f {east, west}.\!focused; \
    bspc config pointer_follows_focus false;

super + shift + {period, comma}
    bspc config pointer_follows_focus true; \
    bspc node -m {east.\!focused, west.\!focused} -f; \
    bspc config pointer_follows_focus false;

# focus the next/previous node in the current desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local.occupied

super + shift + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + Tab
	bspc desktop -f last.local.occupied

super + Return
	bspc node -s last.local; \
	flash_window

# focus the older or newer node in the focus history
super + {o,i}
	bspc wm -h off; \
	bspc node {newer,older} -f; \
	bspc wm -h on

# focus or send to the given desktop
super + shift + {1-9,0}
	d=($(bspc query --desktops --monitor));\
	i='{1-9,10}'; \
	bspc node -d ${d[$i]}

# focus or send to the given desktop
super + {1-9,0}
	d=($(bspc query --desktops --monitor));\
	i='{1-9,10}'; \
	bspc desktop -f ${d[$i]}

super + alt + {1-9,0}
	i='{1-9,10}'; \
	swap-desktops $i

super + alt + shift + {1-9,0}
	i='{1-9,10}'; \
	send-to-monitor $i

super + shift + {1-9,0}
	bspc node -d '^{1-9,10}'

bspc

#
# preselect
#

# preselect the direction
super + {shift + g,  v, shift + v, g}
	bspc node -p {west,south,north,east}

super + e
	bspc node -n 'last.!automatic.local'

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#

# expand a window by moving one of its side outward
super + alt + {h,j,k,l}
  STEP=200; SELECTION={1,2,3,4}; \
  bspc node -z $(echo "left -$STEP 0,bottom 0 -$STEP,top 0 -$STEP,right -$STEP 0" | cut -d',' -f$SELECTION) || \
  bspc node -z $(echo "right $STEP 0,top 0 $STEP,bottom 0 $STEP,left $STEP 0" | cut -d',' -f$SELECTION)

# contract a window by moving one of its side inward
# super + alt + shift + {h,j,k,l}
# 	bspc node -z {right -30 0,top 0 30,bottom 0 -30,left 30 0}

# move a floating window
super + alt + shift + {h,j,k,l}
	bspc node -v {-200 0,0 200,0 -200,200 0}

super + shift + r
        bspc node @/ -R -90

super + r
        bspc node @/ -R 90

# add to tabbed container
ctrl + alt + {Left,Down,Up,Right}
    tabc attach $(bspc query -N -n) {$(bspc query -N -n west),$(bspc query -N -n south),$(bspc query -N -n north),$(bspc query -N -n east)}

# create/remove from tabbed container
super + a
    id=$(bspc query -N -n); \
    [[ "$(tabc printclass $id)" == "tabbed" ]] \
    && tabc detach $id \
    || tabc create $id

# toggle autoattach in tabbed container
super + shift + a
    tabc autoattach $(bspc query -N -n)

super + z
        em1

super + shift + z
        em2

super + alt + space
        kbdlayout

super + n
        flash_window

# hide bar
super + b
        hidebar

XF86AudioLowerVolume
	volume down

XF86AudioRaiseVolume
	volume up

XF86AudioMute
	volume mute

XF86MonBrightnessUp
	bluefilter up

XF86AudioPlay
	spotifycli --play

XF86AudioPause
	spotifycli --pause

XF86AudioNext
	spotifycli --next

XF86AudioPrev
	spotifycli --prev

XF86AudioLowerVolume
	volume down

super + shift + q
        end-session

super + {semicolon, apostrophe}
        {scratchpad --toggle 1, scratchpad --toggle 2}

hyper + {equal, ctrl + equal, alt + equal, shift + equal}
	{screenshot all, screenshot selection, screenshot focus, screenshot delay}
