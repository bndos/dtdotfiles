#!/bin/bash

function send_notification {
    filter_perc=$1

    icon="~/.local/share/icons/"
    # Send the notification
    if (( $filter_perc == 100 ))
    then
    icon="${icon}/colors-chromared.svg"
    elif (( $filter_perc > 70 ))
    then
    icon="${icon}/color-picker-black.svg"
    elif (( $filter_perc > 35 )) && (( $filter_perc < 75 ))
    then
    icon="${icon}/color-picker-white.svg"
    elif (( $filter_perc <= 5 ))
    then
    icon="${icon}/colors-chromablue.svg"
    else
    icon="${icon}/colors-chromablue.svg"
    fi

    dunstify -i $icon -r 2593 -u low "Bluefilter" -h int:value:"$filter_perc"
}

filter_file=$HOME/.cache/filter

if [[ ! -e $filter_file || ! -s "$filter_file" ]]; then
    echo "0" > $filter_file
fi

filter_perc=$(cat $filter_file)

if [[ "$1" == "--recover" ]]; then
    gamma=$(( 6500 - $filter_perc * 55 ))
    redshift -PO $gamma
    send_notification $filter_perc
elif [ $filter_perc -ne 60 ]; then
    redshift -PO 3300
    echo 60 > $filter_file
    send_notification 60
else
    redshift -PO 6500
    echo 0 > $filter_file
    send_notification 0
fi
