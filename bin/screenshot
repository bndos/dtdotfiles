#!/bin/bash

screenshot_dir=$HOME/Pictures/screenshots
mkdir -p $screenshot_dir
icon=camera
case $1 in
    all)
	scrot $screenshot_dir/screenshot_%y-%m-%d_%H:%M:%S.png
	dunstify -i ${icon} -t 1000 "screenshot saved"
	;;
    delay)
	scrot -d 5 $screenshot_dir/screenshot_%y-%m-%d_%H:%M:%S.png
	dunstify -i ${icon} -t 1000 "screenshot delay saved"
	;;
    focus)
	scrot -u $screenshot_dir/screenshot_%y-%m-%d_%H:%M:%S.png
	dunstify -i ${icon} -t 1000 "screenshot focused window saved"
	;;
    selection)
	sleep 1
	scrot -d 1 -s $screenshot_dir/screenshot_%y-%m-%d_%H:%M:%S.png
	dunstify -i ${icon} -t 1000 "screenshot selection saved"
	;;
    delay-focus)
	scrot -u -d 5 $screenshot_dir/screenshot_%y-%m-%d_%H:%M:%S.png
	dunstify -i ${icon} -t 1000 "screenshot focused window saved"
	;;
esac

