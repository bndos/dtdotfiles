#!/bin/bash

pkill emacs
cd ~
find ~/.emacs.d -type f -name ".emacs.desktop.lock" -exec rm -f {} \;

export MODELINE="➊"
emacs --daemon=workspace1
dunstify -i emacs "emacsd ws1 ready" &
export MODELINE="➋"
emacs --daemon=workspace2
dunstify -i emacs "emacsd ws2 ready" &
export MODELINE="➌"
emacs --daemon=workspace3
dunstify -i emacs "emacsd ws3 ready" &
export MODELINE="➍"
emacs --daemon=workspace4
dunstify -i emacs "emacsd ws4 ready" &
