#!/bin/bash

pkill emacs
cd ~

emacs --daemon=workspace1 -l ~/.emacs.d/ws1
notify-send "emacsd ws1 ready" &
emacs --daemon=workspace2 -l ~/.emacs.d/ws2
notify-send "emacsd ws2 ready" &
emacs --daemon=workspace3 -l ~/.emacs.d/ws3
notify-send "emacsd ws3 ready" &
emacs --daemon=workspace4 -l ~/.emacs.d/ws4
notify-send "emacsd ws4 ready" &
