#!/bin/bash

checkfor () {
    command -v $1 >/dev/null 2>&1 || { 
        echo >&2 "$1 required"; 
        exit 1; 
    }
}

checkfor "xdotool"

file=/tmp/active_windows
touch $file

case $1 in
    
--add)
    wid=$(xdotool getactivewindow)
    pid=$(xdotool getactivewindow getwindowpid)
    wname=$(ps -p $pid -o comm=)
    lines=$(wc -l $file | awk '{print $1}')

    xdotool windowunmap $wid
    echo "$wid $lines:$wname" >> $file
    ;;

--retreive)
    res=$(cat $file | awk '{print $2}' | run_search)

    if [[ ! -z "$res" ]] ; then
	res=$(grep -e "$res" $file | awk '{print $1}')
	xdotool windowmap $res
	sed -i "/$res/d" $file
    fi
    ;;
--toggle)
    file=/tmp/last_active_window$2
    if [[ -s $file ]] ; then
	xdotool windowmap `cat $file`
	cat /dev/null > $file
    else
	wid=$(xdotool getactivewindow)
	xdotool windowunmap $wid
	echo $wid > $file
    fi
    ;;
esac
