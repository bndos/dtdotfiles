#!/bin/bash

res=$(echo -e "Lock\nSuspend\nLogout\nReboot\nPoweroff" | dmenu -i)

if [ "$res" = "Lock" ]; then
    betterlockscreen -l dimblur
fi
if [ "$res" = "Suspend" ]; then
    betterlockscreen -l dimblur&
    sleep 0.5
    xset dpms force off
fi
if [ "$res" = "Logout" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill compton
    pkill flashfocus
    pkill autostart.sh
    pkill dwm
    pkill spectrwm
fi
if [ "$res" = "Reboot" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill compton
    pkill flashfocus
    reboot
fi
if [ "$res" = "Poweroff" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill compton
    poweroff
fi
exit 0
