#!/bin/bash

res=$(echo -e "Lock\nSuspend\nLogout\nReboot\nPoweroff" | dmenu -i)

if [ "$res" = "Lock" ]; then
    xscreensaver-command --lock
fi
if [ "$res" = "Suspend" ]; then
    xscreensaver-command --lock&
    sleep 3
    systemctl suspend
fi
if [ "$res" = "Logout" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill flashfocus
    pkill autostart.sh
    bspc quit
    pkill dwm
    pkill xmonad
fi
if [ "$res" = "Reboot" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill flashfocus
    reboot
fi
if [ "$res" = "Poweroff" ]; then
    rm ~/Dropbox/.dropbox.cache -rf
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    poweroff
fi
exit 0
