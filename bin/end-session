#!/bin/bash

res=$(echo -e "      Lock\n      Blank\n      Logout\n      Reboot\n      Poweroff" | rofi -dmenu -i -p ">" )

if [ "$res" = "      Lock" ]; then
    betterlockscreen -l dimblur
fi
if [ "$res" = "      Blank" ]; then
    betterlockscreen -l dimblur&
    sleep 0.5
    xset dpms force off
fi
if [ "$res" = "      Logout" ]; then
    pkill --signal SIGKILL firefox
    pkill qutebrowser
    pkill flashfocus
    pkill autostart.sh
    pkill dwm
fi
if [ "$res" = "      Reboot" ]; then
    reboot
fi
if [ "$res" = "      Poweroff" ]; then
    poweroff
fi
exit 0
