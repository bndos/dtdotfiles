#!/bin/bash

res=$(echo -e "Lock\nSuspend\nLogout\nReboot\nPoweroff" | dmenu -i -w 3775 -x 15)

if [ "$res" = "Lock" ]; then
    lock
fi
if [ "$res" = "Suspend" ]; then
    lock&
    sleep 3
    systemctl suspend
fi
if [ "$res" = "Logout" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill compton
    pkill flashfocus
    pkill autostart.sh
    bspc quit
    pkill dwm
    pkill xmonad
fi
if [ "$res" = "Reboot" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill compton
    pkill flashfocus
    reboot
fi
if [ "$res" = "Poweroff" ]; then
    pkill --signal SIGKILL firefox
    pkill emacs
    pkill dunst
    pkill compton
    poweroff
fi
exit 0
