#!/bin/bash

function send_notification {
    filter_perc=$1
    
    bar=$(seq -s "─" $(($filter_perc / 5 + 1)) | sed 's/[0-9]//g')
    # Send the notification
    if (( $filter_perc == 100 ))
    then
	dunstify -i ~/.local/share/icons/colors-chromared.svg -r 2593 -u low  "$filter_perc $bar"
    elif (( $filter_perc > 70 ))
    then
	dunstify -i ~/.local/share/icons/color-picker-black.svg -r 2593 -u low  "$filter_perc  $bar"
    elif (( $filter_perc > 35 )) && (( $filter_perc < 75 ))
    then
	dunstify -i ~/.local/share/icons/color-picker-white.svg -r 2593 -u low  "$filter_perc  $bar"
    elif (( $filter_perc <= 5 ))
    then
	dunstify -i ~/.local/share/icons/colors-chromablue.svg -r 2593 -u low  "$filter_perc   $bar"
    else
	dunstify -i ~/.local/share/icons/colors-chromablue.svg -r 2593 -u low  "$filter_perc  $bar"
    fi
}

filter_file=/tmp/filter

if [ ! -e $filter_file ]; then
    echo "0" > $filter_file
fi

if [ "$1" == "up" ]
then
    filter_perc=$(cat /tmp/filter)
    send_notification $filter_perc
    if [ $filter_perc -ne 100 ]
       then
	   filter_perc=$(($(cat /tmp/filter) + 5))
	   send_notification $filter_perc
	   gamma=$(( 6500 - $filter_perc * 55 ))
	   redshift -PO $gamma
	   echo $filter_perc > /tmp/filter
    fi
elif [ "$1" == "down" ]
then
    filter_perc=$(cat /tmp/filter)
    send_notification $filter_perc
    if [ $filter_perc -ne 0 ]
       then
	   filter_perc=$(($(cat /tmp/filter) - 5))
	   send_notification $filter_perc
	   gamma=$(( 6500 - $filter_perc * 55 ))
	   redshift -PO $gamma
	   echo $filter_perc > /tmp/filter
    fi
fi
