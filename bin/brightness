#!/bin/bash

# You can call this script like this:
# $./volume up
# $./volume down
# $./volume mute

function get_brightness {
    brightness=$(light)
    echo ${brightness%.*}
}

function send_notification {
    brightness=`get_brightness`
    # Make the bar with the special character ─ (it's not dash -)
    # https://en.wikipedia.org/wiki/Box-drawing_character
    # Send the notification

    icon="~/.local/share/icons/"
    if (( $brightness > 60 ))
    then
    icon="${icon}brightness-high.svg"
    elif (( $brightness > 20 ))
    then
    icon="${icon}brightness-medium.svg"
    else
    icon="${icon}brightness-low.svg"
    fi

    dunstify -i $icon -r 2593 -u low "Brightness" -h int:value:"$brightness"
}

case $1 in
    up)
    brightnessctl set +5%
    send_notification
    ;;
    down)
    if (( $(get_brightness) > 5 ))
    then
        brightnessctl set 5%-
    fi
    send_notification
    ;;
esac
