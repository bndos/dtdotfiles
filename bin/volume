#!/bin/bash

# You can call this script like this:
# $./volume up
# $./volume down
# $./volume mute

function get_volume {
    amixer -D pulse get Master | grep '%' | head -n 1 | cut -d '[' -f 2 | cut -d '%' -f 1
}

function is_mute {
    amixer -D pulse get Master | grep '%' | grep -oE '[^ ]+$' | grep off > /dev/null
}

function send_notification {
    volume=`get_volume`
    icon="~/.local/share/icons/"
    if is_mute
    then
    icon="${icon}audio-volume-muted.svg"
    dunstify -i $icon -u low -r 2593 "Muted" -h int:value:"0"
    return
    fi

    if (( $volume > 40 ))
    then
    icon="${icon}audio-volume-high.svg"
    elif (( $volume > 5 ))
    then
    icon="${icon}audio-volume-medium.svg"
    else
    icon="${icon}audio-volume-muted.svg"
    fi

    dunstify -i $icon -u low -r 2593 "Volume" -h int:value:"$volume"
}

case $1 in
    up)
    # Set the volume on (if it was muted)
    amixer -D pulse set Master on > /dev/null
    # Up the volume (+ 5%)
    amixer -D pulse sset Master 5%+ > /dev/null
    send_notification
    ;;
    down)
    amixer -D pulse set Master on > /dev/null
    amixer -D pulse sset Master 5%- > /dev/null
    send_notification
    ;;
    mute)
    amixer -D pulse set Master 1+ toggle > /dev/null
    send_notification
    ;;
esac
